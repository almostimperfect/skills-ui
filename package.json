{
  "name": "skills-ui",
  "version": "0.1.0",
  "description": "Visual management layer for vercel-labs/skills",
  "license": "MIT",
  "type": "module",
  "bin": {
    "skills-ui": "./dist/cli/index.js"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "build": "npm run build:server && npm run build:web",
    "check:lock-policy": "node scripts/check-lock-policy.mjs",
    "test:lock-policy": "node scripts/check-lock-policy.mjs --self-test",
    "dev:server": "node --import tsx/esm src/cli/index.ts serve",
    "dev:web": "vite",
    "seed:xtest": "node scripts/seed-xtest-data.mjs seed",
    "cleanup:xtest": "node scripts/seed-xtest-data.mjs cleanup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docker": "sh scripts/run-docker-tests.sh",
    "test:e2e": "sh e2e/scripts/run-e2e.sh",
    "test:e2e:network": "sh e2e/scripts/run-e2e.sh --network"
  },
  "dependencies": {
    "commander": "12.1.0",
    "express": "4.22.1",
    "gray-matter": "4.0.3",
    "skills": "1.4.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@playwright/test": "1.49.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "postcss": "8.5.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.1",
    "@tanstack/react-query": "5.90.21",
    "tailwindcss": "3.4.19",
    "supertest": "7.2.2",
    "@types/supertest": "6.0.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "2.1.9"
  },
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  }
}
